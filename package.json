{
  "name": "year-in-code",
  "displayName": "Year in Code: Git Year in Review",
  "description": "Your coding year, wrapped: commits, streaks, languages, busiest hours and your coder type, from your local git history. Share it as an image. No account, no token.",
  "version": "1.0.0",
  "publisher": "mehmeteminakkaya",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehmeteminakkaya/year-in-code"
  },
  "bugs": {
    "url": "https://github.com/mehmeteminakkaya/year-in-code/issues"
  },
  "sponsor": {
    "url": "https://buymeacoffee.com/mehmeteminf"
  },
  "galleryBanner": {
    "color": "#1b1a22",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "wrapped",
    "year in review",
    "statistics",
    "commits",
    "stats",
    "recap",
    "streak"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "yearInCode.show",
        "title": "Show My Year in Code",
        "category": "Year in Code",
        "icon": "$(calendar)"
      }
    ],
    "configuration": {
      "title": "Year in Code",
      "properties": {
        "yearInCode.authorEmails": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra email addresses that are you (for commits made from other machines or accounts). Your git user.email is always included."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:vscode": "node test/vscode/run.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.2",
    "gifenc": "^1.0.3",
    "playwright": "1.56.1",
    "pngjs": "^7.0.0"
  }
}
